# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Stray compiled JS emitted next to TS/TSX sources — never commit these.
# Vite resolves .js before .tsx, so a committed twin silently shadows the source.
src/**/*.js
src/**/*.js.map
/vite.config.js

