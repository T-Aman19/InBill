DEPLOYMENT_MODE=local
PORT=3005
DATABASE_URL=postgresql://localhost:5432/inbill
JWT_SECRET=dev-secret-do-not-use-in-prod

# Cloud only — email-based password reset
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@inbill.app
APP_URL=https://inbill.app

# AI features (menu description generator, menu import, reports Q&A) — all Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Subscription billing (cloud only) — Razorpay Subscriptions.
# Keys from Razorpay Dashboard; webhook secret from the webhook you create
# (endpoint: /api/billing/webhook, events: subscription.*).
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# One Razorpay Plan id per tier × cycle (Dashboard → Subscriptions → Plans).
RAZORPAY_PLAN_STARTER_MONTHLY=plan_...
RAZORPAY_PLAN_STARTER_ANNUAL=plan_...
RAZORPAY_PLAN_GROWTH_MONTHLY=plan_...
RAZORPAY_PLAN_GROWTH_ANNUAL=plan_...
